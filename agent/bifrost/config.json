{
  "$schema": "https://www.getbifrost.ai/schema",
  "source_of_truth": "config.json",
  "client": {
    "enable_logging": true,
    "disable_content_logging": true,
    "compat": {
      "should_drop_params": true,
      "should_convert_params": true,
      "convert_chat_to_responses": true
    }
  },
  "providers": {
    "commandcode": {
      "keys": [
        {
          "name": "commandcode",
          "value": "env.COMMANDCODE_API_KEY",
          "models": ["*"]
        }
      ],
      "network_config": {
        "base_url": "https://api.commandcode.ai/provider/v1"
      },
      "custom_provider_config": {
        "base_provider_type": "openai"
      }
    },
    "nous": {
      "keys": [
        {
          "name": "nous",
          "value": "env.NOUS_API_KEY",
          "models": ["*"]
        }
      ],
      "network_config": {
        "base_url": "https://inference-api.nousresearch.com"
      },
      "custom_provider_config": {
        "base_provider_type": "openai"
      }
    },
    "ollama": {
      "keys": [
        {
          "name": "ollama-cloud",
          "value": "env.OLLAMA_API_KEY",
          "models": ["*"],
          "ollama_key_config": {
            "url": "https://ollama.com"
          }
        }
      ]
    },
    "opencode-go": {
      "keys": [
        {
          "name": "opencode-go",
          "value": "env.OPENCODE_GO_API_KEY",
          "models": ["*"]
        }
      ]
    },
    "opencode-zen": {
      "keys": [
        {
          "name": "opencode-zen",
          "value": "env.OPENCODE_ZEN_API_KEY",
          "models": ["*"]
        }
      ]
    }
  },
  "governance": {
    "virtual_keys": [
      {
        "id": "main",
        "name": "Main",
        "value": "env.BIFROST_API_KEY",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "commandcode",
            "allowed_models": ["*"],
            "key_ids": ["*"]
          },
          {
            "provider": "nous",
            "allowed_models": ["*"],
            "key_ids": ["*"]
          },
          {
            "provider": "ollama",
            "allowed_models": ["*"],
            "key_ids": ["*"]
          },
          {
            "provider": "opencode-go",
            "allowed_models": ["*"],
            "key_ids": ["*"]
          },
          {
            "provider": "opencode-zen",
            "allowed_models": ["*"],
            "key_ids": ["*"]
          }
        ]
      }
    ],
    "routing_rules": [
      {
        "id": "simple",
        "name": "Simple",
        "enabled": true,
        "chain_rule": false,
        "cel_expression": "model == \"auto\" && complexity_tier == \"SIMPLE\"",
        "targets": [{ "provider": "opencode-zen", "model": "hy3-free" }],
        "fallbacks": ["nous/tencent/hy3:free", "opencode-go/hy3"],
        "scope": "global",
        "priority": 10
      },
      {
        "id": "medium",
        "name": "Medium",
        "enabled": true,
        "chain_rule": false,
        "cel_expression": "model == \"auto\" && complexity_tier == \"MEDIUM\"",
        "targets": [{ "provider": "opencode-zen", "model": "hy3-free" }],
        "fallbacks": ["nous/tencent/hy3:free", "opencode-go/hy3"],
        "scope": "global",
        "priority": 20
      },
      {
        "id": "complex",
        "name": "Complex",
        "enabled": true,
        "chain_rule": false,
        "cel_expression": "model == \"auto\" && complexity_tier == \"COMPLEX\"",
        "targets": [{ "provider": "opencode-zen", "model": "hy3-free" }],
        "fallbacks": ["nous/tencent/hy3:free", "opencode-go/hy3"],
        "scope": "global",
        "priority": 30
      },
      {
        "id": "reasoning",
        "name": "Reasoning",
        "enabled": true,
        "chain_rule": false,
        "cel_expression": "model == \"auto\" && complexity_tier == \"REASONING\"",
        "targets": [{ "provider": "opencode-zen", "model": "hy3-free" }],
        "fallbacks": ["nous/tencent/hy3:free", "opencode-go/hy3"],
        "scope": "global",
        "priority": 40
      },
      {
        "id": "auto",
        "name": "Auto",
        "enabled": true,
        "chain_rule": false,
        "cel_expression": "model == \"auto\"",
        "targets": [{ "provider": "opencode-zen", "model": "hy3-free" }],
        "fallbacks": ["nous/tencent/hy3:free", "opencode-go/hy3"],
        "scope": "global",
        "priority": 90
      },
      {
        "id": "multimodal",
        "name": "Multimodal",
        "enabled": true,
        "chain_rule": false,
        "cel_expression": "model == \"multimodal\"",
        "targets": [{ "provider": "opencode-zen", "model": "mimo-v2.5-free" }],
        "fallbacks": ["opencode-go/mimo-v2.5"],
        "scope": "global",
        "priority": 100
      }
    ]
  },
  "logs_store": {
    "enabled": true,
    "type": "sqlite",
    "config": { "path": "./logs.db" },
    "retention_days": 90
  }
}
