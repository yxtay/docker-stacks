{
  "$schema": "https://www.getbifrost.ai/schema",
  "encryption_key": "env.BIFROST_ENCRYPTION_KEY",
  "client": {
    "drop_excess_requests": false,
    "enable_logging": true
  },
  "providers": {
    "cerebras": {
      "keys": [
        {
          "name": "cerebras-primary",
          "value": "env.CEREBRAS_API_KEY",
          "models": ["*"],
          "weight": 1.0,
          "aliases": {
            "gemma-4-31b": "gemma-4-31b"
          }
        }
      ]
    },
    "gemini": {
      "keys": [
        {
          "name": "gemini-primary",
          "value": "env.GEMINI_API_KEY",
          "models": ["*"],
          "weight": 1.0,
          "aliases": {
            "gemini-flash-lite-latest": "gemini-flash-lite-latest",
            "gemma-4-31b-it": "gemma-4-31b-it"
          }
        }
      ]
    },
    "groq": {
      "keys": [
        {
          "name": "groq-primary",
          "value": "env.GROQ_API_KEY",
          "models": ["*"],
          "weight": 1.0,
          "aliases": {
            "gpt-oss-120b": "openai/gpt-oss-120b"
          }
        }
      ]
    },
    "openrouter": {
      "keys": [
        {
          "name": "openrouter-primary",
          "value": "env.OPENROUTER_API_KEY",
          "models": ["*"],
          "weight": 1.0,
          "aliases": {
            "openrouter:free": "openrouter/free"
          }
        }
      ]
    },
    "nous": {
      "keys": [
        {
          "name": "nous-primary",
          "value": "env.NOUS_API_KEY",
          "models": ["*"],
          "weight": 1.0,
          "aliases": {
            "hy3:free": "tencent/hy3:free"
          }
        }
      ],
      "network_config": {
        "base_url": "http://headroom:8787",
        "extra_headers": {
          "x-headroom-base-url": "https://inference-api.nousresearch.com/v1"
        }
      },
      "custom_provider_config": {
        "base_provider_type": "openai"
      }
    },
    "opencode_zen": {
      "keys": [
        {
          "name": "opencode-zen-primary",
          "value": "env.OPENCODE_ZEN_API_KEY",
          "models": ["*"],
          "weight": 1.0,
          "aliases": {
            "deepseek-v4-flash:free": "deepseek-v4-flash-free",
            "mimo-v2.5:free": "mimo-v2.5-free"
          }
        }
      ],
      "network_config": {
        "base_url": "http://headroom:8787",
        "extra_headers": {
          "x-headroom-base-url": "https://opencode.ai/zen/v1"
        }
      },
      "custom_provider_config": {
        "base_provider_type": "openai"
      }
    },
    "opencode_go": {
      "keys": [
        {
          "name": "opencode-go-primary",
          "value": "env.OPENCODE_GO_API_KEY",
          "models": ["*"],
          "weight": 1.0,
          "aliases": {
            "deepseek-v4-flash:low": "deepseek-v4-flash",
            "deepseek-v4-flash:high": "deepseek-v4-flash",
            "deepseek-v4-flash:max": "deepseek-v4-flash",
            "deepseek-v4-pro:max": "deepseek-v4-pro"
          }
        }
      ],
      "network_config": {
        "base_url": "http://headroom:8787",
        "extra_headers": {
          "x-headroom-base-url": "https://opencode.ai/zen/go/v1"
        }
      },
      "custom_provider_config": {
        "base_provider_type": "openai"
      }
    }
  },
  "config_store": {
    "enabled": true
  },
  "logs_store": {
    "enabled": true
  }
}
