{
  "$schema": "https://www.getbifrost.ai/schema",
  "encryption_key": "env.BIFROST_ENCRYPTION_KEY",
  "client": {
    "enable_logging": true
  },
  "providers": {
    "cerebras": {
      "keys": [
        {
          "name": "cerebras-primary",
          "value": "env.CEREBRAS_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "default_request_timeout_in_seconds": 300,
        "max_retries": 3
      }
    },
    "gemini": {
      "keys": [
        {
          "name": "gemini-primary",
          "value": "env.GEMINI_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "default_request_timeout_in_seconds": 300,
        "max_retries": 3
      }
    },
    "groq": {
      "keys": [
        {
          "name": "groq-primary",
          "value": "env.GROQ_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "default_request_timeout_in_seconds": 300,
        "max_retries": 3
      }
    },
    "openrouter": {
      "keys": [
        {
          "name": "openrouter-primary",
          "value": "env.OPENROUTER_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "default_request_timeout_in_seconds": 300,
        "max_retries": 3
      }
    },
    "nous": {
      "keys": [
        {
          "name": "nous-primary",
          "value": "env.NOUS_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://headroom:8787",
        "default_request_timeout_in_seconds": 300,
        "max_retries": 3,
        "extra_headers": {
          "x-headroom-base-url": "https://inference-api.nousresearch.com/v1"
        }
      },
      "custom_provider_config": {
        "base_provider_type": "openai"
      }
    },
    "opencode_zen": {
      "keys": [
        {
          "name": "opencode-zen-primary",
          "value": "env.OPENCODE_ZEN_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://headroom:8787",
        "default_request_timeout_in_seconds": 300,
        "max_retries": 3,
        "extra_headers": {
          "x-headroom-base-url": "https://opencode.ai/zen/v1"
        }
      },
      "custom_provider_config": {
        "base_provider_type": "openai"
      }
    },
    "opencode_go": {
      "keys": [
        {
          "name": "opencode-go-primary",
          "value": "env.OPENCODE_GO_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://headroom:8787",
        "default_request_timeout_in_seconds": 300,
        "max_retries": 3,
        "extra_headers": {
          "x-headroom-base-url": "https://opencode.ai/zen/go/v1"
        }
      },
      "custom_provider_config": {
        "base_provider_type": "openai"
      }
    }
  },
  "logs_store": {
    "retention_days": 90
  }
}
