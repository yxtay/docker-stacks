{
  "$schema": "https://www.getbifrost.ai/schema",
  "source_of_truth": "config.json",
  "client": {
    "enable_logging": true,
    "disable_content_logging": true,
    "compat": {
      "should_drop_params": true,
      "should_convert_params": true,
      "convert_chat_to_responses": true
    }
  },
  "providers": {
    "opencode-go": {
      "keys": [
        {
          "name": "opencode-go",
          "value": "env.OPENCODE_GO_API_KEY",
          "models": ["*"]
        }
      ],
      "network_config": {
        "default_request_timeout_in_seconds": 300,
        "max_retries": 3
      }
    },
    "opencode-zen": {
      "keys": [
        {
          "name": "opencode-zen",
          "value": "env.OPENCODE_ZEN_API_KEY",
          "models": ["*"]
        }
      ],
      "network_config": {
        "default_request_timeout_in_seconds": 300,
        "max_retries": 3
      }
    }
  },
  "governance": {
    "routing_rules": [
      {
        "id": "simple",
        "name": "Simple",
        "enabled": true,
        "chain_rule": false,
        "cel_expression": "model == \"auto\" && complexity_tier == \"SIMPLE\"",
        "targets": [{ "provider": "opencode-go", "model": "hy3" }],
        "fallbacks": [
          "opencode-zen/deepseek-v4-flash-free",
          "opencode-go/mimo-v2.5"
        ],
        "scope": "global",
        "priority": 10
      },
      {
        "id": "medium",
        "name": "Medium",
        "enabled": true,
        "chain_rule": false,
        "cel_expression": "model == \"auto\" && complexity_tier == \"MEDIUM\"",
        "targets": [{ "provider": "opencode-go", "model": "hy3" }],
        "fallbacks": [
          "opencode-zen/deepseek-v4-flash-free",
          "opencode-go/mimo-v2.5"
        ],
        "scope": "global",
        "priority": 20
      },
      {
        "id": "complex",
        "name": "Complex",
        "enabled": true,
        "chain_rule": false,
        "cel_expression": "model == \"auto\" && complexity_tier == \"COMPLEX\"",
        "targets": [{ "provider": "opencode-go", "model": "hy3" }],
        "fallbacks": [
          "opencode-zen/deepseek-v4-flash-free",
          "opencode-go/mimo-v2.5"
        ],
        "scope": "global",
        "priority": 30
      },
      {
        "id": "reasoning",
        "name": "Reasoning",
        "enabled": true,
        "chain_rule": false,
        "cel_expression": "model == \"auto\" && complexity_tier == \"REASONING\"",
        "targets": [{ "provider": "opencode-go", "model": "hy3" }],
        "fallbacks": [
          "opencode-zen/deepseek-v4-flash-free",
          "opencode-go/mimo-v2.5"
        ],
        "scope": "global",
        "priority": 40
      },
      {
        "id": "auto",
        "name": "Auto",
        "enabled": true,
        "chain_rule": false,
        "cel_expression": "model == \"auto\"",
        "targets": [{ "provider": "opencode-go", "model": "hy3" }],
        "fallbacks": [
          "opencode-zen/deepseek-v4-flash-free",
          "opencode-go/mimo-v2.5"
        ],
        "scope": "global",
        "priority": 90
      },
      {
        "id": "multimodal",
        "name": "Multimodal",
        "enabled": true,
        "chain_rule": false,
        "cel_expression": "model == \"multimodal\"",
        "targets": [
          { "provider": "opencode-go", "model": "hy3" }
        ],
        "fallbacks": ["opencode-zen/mimo-v2.5-free", "opencode-go/mimo-v2.5"],
        "scope": "global",
        "priority": 100
      }
    ]
  },
  "logs_store": {
    "enabled": true,
    "type": "sqlite",
    "config": { "path": "./logs.db" },
    "retention_days": 90
  }
}
