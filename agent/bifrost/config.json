{
  "$schema": "https://www.getbifrost.ai/schema",
  "encryption_key": "env.BIFROST_ENCRYPTION_KEY",
  "client": {
    "enable_logging": true
  },
  "providers": {
    "cerebras": {
      "keys": [
        {
          "name": "cerebras",
          "value": "env.CEREBRAS_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "default_request_timeout_in_seconds": 300,
        "max_retries": 3
      }
    },
    "gemini": {
      "keys": [
        {
          "name": "gemini",
          "value": "env.GEMINI_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "default_request_timeout_in_seconds": 300,
        "max_retries": 3
      }
    },
    "groq": {
      "keys": [
        {
          "name": "groq",
          "value": "env.GROQ_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "default_request_timeout_in_seconds": 300,
        "max_retries": 3
      }
    },
    "openrouter": {
      "keys": [
        {
          "name": "openrouter",
          "value": "env.OPENROUTER_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "default_request_timeout_in_seconds": 300,
        "max_retries": 3
      }
    },
    "nous": {
      "keys": [
        {
          "name": "nous",
          "value": "env.NOUS_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://headroom:8787",
        "default_request_timeout_in_seconds": 300,
        "max_retries": 3,
        "extra_headers": {
          "x-headroom-base-url": "https://inference-api.nousresearch.com/v1"
        }
      },
      "custom_provider_config": {
        "base_provider_type": "openai"
      }
    },
    "opencode_zen": {
      "keys": [
        {
          "name": "opencode-zen",
          "value": "env.OPENCODE_ZEN_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://headroom:8787",
        "default_request_timeout_in_seconds": 300,
        "max_retries": 3,
        "extra_headers": {
          "x-headroom-base-url": "https://opencode.ai/zen/v1"
        }
      },
      "custom_provider_config": {
        "base_provider_type": "openai"
      }
    },
    "opencode_go": {
      "keys": [
        {
          "name": "opencode-go",
          "value": "env.OPENCODE_GO_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://headroom:8787",
        "default_request_timeout_in_seconds": 300,
        "max_retries": 3,
        "extra_headers": {
          "x-headroom-base-url": "https://opencode.ai/zen/go/v1"
        }
      },
      "custom_provider_config": {
        "base_provider_type": "openai"
      }
    }
  },
  "governance": {
    "routing_rules": [
      {
        "id": "complexity-simple",
        "name": "Simple",
        "enabled": true,
        "chain_rule": false,
        "cel_expression": "model == \"auto\" && complexity_tier == \"SIMPLE\"",
        "targets": [
          {
            "provider": "opencode_zen",
            "model": "deepseek-v4-flash-free",
            "weight": 1.0
          }
        ],
        "fallbacks": ["opencode_zen/mimo-v2.5-free"]
      },
      {
        "id": "complexity-medium",
        "name": "Medium",
        "enabled": true,
        "chain_rule": false,
        "cel_expression": "model == \"auto\" && complexity_tier == \"MEDIUM\"",
        "targets": [
          {
            "provider": "opencode_zen",
            "model": "deepseek-v4-flash-free",
            "weight": 1.0
          }
        ],
        "fallbacks": ["opencode_zen/mimo-v2.5-free"]
      },
      {
        "id": "complexity-complex",
        "name": "Complex",
        "enabled": true,
        "chain_rule": false,
        "cel_expression": "model == \"auto\" && complexity_tier == \"COMPLEX\"",
        "targets": [
          {
            "provider": "opencode_zen",
            "model": "deepseek-v4-flash-free",
            "weight": 1.0
          }
        ],
        "fallbacks": ["opencode_zen/mimo-v2.5-free"]
      },
      {
        "id": "complexity-reasoning",
        "name": "Reasoning",
        "enabled": true,
        "chain_rule": false,
        "cel_expression": "model == \"auto\" && complexity_tier == \"REASONING\"",
        "targets": [
          {
            "provider": "opencode_zen",
            "model": "deepseek-v4-flash-free",
            "weight": 1.0
          }
        ],
        "fallbacks": ["opencode_zen/mimo-v2.5-free"]
      }
    ]
  },
  "logs_store": {
    "retention_days": 90
  }
}
