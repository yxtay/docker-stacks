{
	# debug
	order crowdsec first

	log {
		format json {
			time_format rfc3339
		}
	}
	acme_dns duckdns {env.DUCKDNS_TOKEN} # for DuckDNS

	crowdsec {
		api_url http://crowdsec:8080
		api_key {env.CROWDSEC_API_KEY}
	}

	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
	}
}

