(security_headers) {
	header {
		# https://cheatsheetseries.owasp.org/cheatsheets/HTTP_Headers_Cheat_Sheet.html

		# Restrictive baseline CSP
		# 'unsafe-inline' needed for LibreSpeed
		# 'unsafe-eval' needed for Immich and Immich Kiosk
		?Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' https:; connect-src 'self' wss: ws:; frame-ancestors 'self'; form-action 'self'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests"

		# Process-Isolate documents to prevent others from access in pop-up window
		?Cross-Origin-Opener-Policy "same-origin"

		# Limit current resource loading to the site and sub-domains only
		?Cross-Origin-Resource-Policy "same-site"

		# Disable FLoC tracking
		Permissions-Policy "interest-cohort=()"

		# Set Referrer Policy
		Referrer-Policy "strict-origin-when-cross-origin"

		# Enable HTTP Strict Transport Security (HSTS)
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# Remove identifying headers
		-Server
		-Via
		-X-Powered-By

		# Disallow sniffing of X-Content-Type-Options
		X-Content-Type-Options "nosniff"

		# Disable DNS prefetching
		?X-DNS-Prefetch-Control "off"

		# Disallow the site to be rendered within a frame (clickjacking protection)
		X-Frame-Options "SAMEORIGIN"

		# Disable cross-domain policy file loading
		X-Permitted-Cross-Domain-Policies "none"

		# Prevent search engines from indexing
		?X-Robots-Tag "noindex, nofollow"

		# Disable buggy browser XSS filters
		X-XSS-Protection "0"
	}
}

(defaults) {
	crowdsec
	import security_headers
	encode zstd gzip
}

(reverse_proxy) {
	@{args[0]} host {args[0]}.{env.DOMAIN}
	handle @{args[0]} {
		reverse_proxy {args[1]} {
			fail_duration 30s
		}
	}
}

(tinyauth) {
	@remote not client_ip private_ranges
	forward_auth @remote tinyauth:3000 {
		uri /api/auth/caddy
		copy_headers Remote-User Remote-Name Remote-Email Remote-Groups
	}
}

(reverse_proxy_auth) {
	@{args[0]} host {args[0]}.{env.DOMAIN}
	handle @{args[0]} {
		import tinyauth
		reverse_proxy {args[1]} {
			fail_duration 30s
		}
	}
}

{$DOMAIN} {
	redir https://www.{host}{uri} permanent
}

*.{$DOMAIN} {
	import defaults
	import /config/caddy/extras/*.caddy

	@www host www.{env.DOMAIN}
	handle @www {
		root * /usr/share/caddy
		file_server
	}

	error 404
}
