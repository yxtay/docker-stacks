{
  # debug

  log {
    format json {
      time_format iso8601
    }
  }

  dynamic_dns {
    provider duckdns {$DUCKDNS_API_TOKEN}
    domains {
      {$DOMAIN}
    }
    versions ipv4
  }
  acme_dns duckdns {$DUCKDNS_API_TOKEN}
}

(reverse_proxy) {
  @{args[0]} host {args[0]}.{$DOMAIN}
  handle @{args[0]} {
    reverse_proxy {args[1]} {
      fail_duration 30s
    }
  }
}

:80 {
  root * /usr/share/caddy
  file_server
}

{$DOMAIN} {
  redir https://www.{host}{uri} permanent
}

www.{$DOMAIN} {
  root * /usr/share/caddy
  file_server
}
