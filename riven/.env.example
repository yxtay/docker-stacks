# General
DOMAIN=example.duckdns.org

# postgres
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
POSTGRES_DB=riven

# Core settings; any other RIVEN_SETTING__* can be added here
RIVEN_SETTING__vfsMountPath=/mnt/remote/riven
# generate using `openssl rand -hex 16`
RIVEN_SETTING__apiKey=

# Plugins (tmdb and tvdb are always enabled)
# Options: stremthru, comet, torrentio, mdblist, listrr, seerr, plex, jellyfin, subdl, notifications
RIVEN_SETTING__enabledPlugins=["comet","mdblist","stremthru"]
RIVEN_PLUGIN_SETTING__REPO_PLUGIN_MDBLIST__apiKey=
# JSON array of "username/list-name"
RIVEN_PLUGIN_SETTING__REPO_PLUGIN_MDBLIST__lists=["astrolab/500-most-popular-movies-astrolab","astrolab/500-most-popular-tv-shows-astrolab","snoak/todays-most-popular-movies-on-justwatch","snoak/todays-most-popular-shows-on-justwatch"]
RIVEN_PLUGIN_SETTING__REPO_PLUGIN_STREMTHRU__torboxApiKey=
RIVEN_PLUGIN_SETTING__REPO_PLUGIN_TMDB__apiKey=
RIVEN_PLUGIN_SETTING__REPO_PLUGIN_TVDB__apiKey=
