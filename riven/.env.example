# General
DOMAIN=example.duckdns.org

# postgres
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
POSTGRES_DB=riven

# Core settings; any other RIVEN_SETTING__* can be added here
RIVEN_SETTING__adminUserCredentials=user:password
RIVEN_SETTING__vfsMountPath=/mnt/remote/riven

# Plugins (tmdb and tvdb are always enabled)
# Options: stremthru, comet, torrentio, mdblist, listrr, seerr, plex, jellyfin, subdl, notifications
RIVEN_SETTING__enabledPlugins=["stremthru","comet","mdblist"]
RIVEN_PLUGIN_SETTING__REPO_PLUGIN_TMDB__apiKey=
RIVEN_PLUGIN_SETTING__REPO_PLUGIN_STREMTHRU__torboxApiKey=
RIVEN_PLUGIN_SETTING__REPO_PLUGIN_MDBLIST__apiKey=
# JSON array of "username/list-name"
RIVEN_PLUGIN_SETTING__REPO_PLUGIN_MDBLIST__lists=[]
