# General
DOMAIN=example.duckdns.org

# Postgres
POSTGRES_PASSWORD=changeme

# Riven admin login, format username:password
ADMIN_USER_CREDENTIALS=admin:changeme

# Plugins (tmdb and tvdb are always enabled)
# Options: stremthru, comet, torrentio, mdblist, listrr, seerr, plex, jellyfin, subdl, notifications
ENABLED_PLUGINS=["stremthru","comet","mdblist"]
TMDB_API_KEY=
TORBOX_API_KEY=
MDBLIST_API_KEY=
# JSON array of "username/list-name"
MDBLIST_LISTS=["username/list-name"]
