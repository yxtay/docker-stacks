auto = true
batch = true
confirmbigdel = true
fastcheck = true
links = false
log = false
maxerrors = 10
prefer = newer
times = true

dontchmod = true
group = false
owner = false
perms = 0

ignore = Name __pycache__
ignore = Name .{DS_Store,git}
ignore = Name *.{bak,DS_Store,pid,pyc,lock,sock}
ignore = Name {,.,*.,*-,*_}{cache,tmp}
ignore = Name {node_modules,venv}

ignore = Name MediaCover
ignore = BelowPath altmount/{.nzbs,metadata}
ignore = BelowPath esphome/.esphome
ignore = BelowPath geoip
ignore = Regex hermes/(.*/)?(\.cua-driver|\.local|\.npm|bin|lazy-packages)
ignore = BelowPath homeassistant/{deps,tts}
ignore = BelowPath immich/data/{encoded-video,library,thumbs,upload}
ignore = BelowPath nzbdavex/blobs
ignore = BelowPath portainer/compose
ignore = BelowPath profilarr/data/databases
ignore = BelowPath prowlarr/Definitions
ignore = Path unison/{ar,fp,lk,sc,tm}*
