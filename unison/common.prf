auto = true
batch = true
confirmbigdel = true
fastcheck = true
links = false
log = false
maxerrors = 10
times = true

dontchmod = true
group = false
owner = false
perms = 0

ignorenot = Name *.{conf,ini,json,prf,txt,yaml,yml}
ignore = Name __pycache__
ignore = Name *.{bak,git,pid,pyc,lock}
ignore = Name {,*.}{cache,tmp}

ignore = Name MediaCover
ignore = BelowPath altmount/.nzbs
ignore = BelowPath altmount/metadata
ignore = BelowPath esphome/.esphome
ignore = BelowPath homeassistant/deps
ignore = BelowPath homeassistant/tts
ignore = BelowPath immich/data/encoded-video
ignore = BelowPath immich/data/library
ignore = BelowPath immich/data/thumbs
ignore = BelowPath immich/data/upload
ignore = BelowPath nzbdav/blobs
ignore = BelowPath portainer/compose
ignore = BelowPath profilarr/data/databases
ignore = BelowPath prowlarr/Definitions
ignore = Path unison/ar*
ignore = Path unison/fp*
ignore = Path unison/lk*
ignore = Path unison/sc*
ignore = Path unison/tm*
