# General
TZ=UTC
DOMAIN=example.com

# generate using `openssl rand -hex 16`
USENETSTREAMER_SHARED_SECRET=your-shared-secret

# generate using `openssl rand -hex 32`
ALTMOUNT_JWT_SECRET=your-jwt-secret
AIOSTREAMS_SECRET_KEY=your-aiostreams-secret-key

AIOSTREAMS_AUTH=username:password

# NzbDavEx
# Uses standard TZ and DOMAIN variables. Config is persisted in /apps/nzbdavex
